{
  "name": "web",
  "version": "1.0.0",
  "description": "Next.js frontend for Airbnb clone",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write --ignore-path .gitignore .",
    "format:check": "prettier --check --ignore-path .gitignore .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@airbnb/constants": "workspace:*",
